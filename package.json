{
  "name": "@hcl-software/enchanted-react-components",
  "version": "0.0.0",
  "description": "Private internal React component library for HCL products, built on Base UI.",
  "private": true,
  "license": "Apache-2.0",
  "author": "Hanjo Hagemeier <hanjo.hagemeier@hcl.com>",
  "contributors": [
    "Angelo rick Asoy <angelorick.asoy@hcl.com>",
    "Satish Kumar <kumarsati@hcl.com>"
  ],
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/enchanted.css"
  },
  "files": [
    "dist",
    "!dist/**/*.stories.*",
    "!dist/**/*.figma.*",
    "!dist/**/*.test.*",
    "!dist/**/__tests__",
    "CHANGELOG.md",
    "README.md",
    "LICENSE.txt"
  ],
  "engines": {
    "node": ">=24 <25"
  },
  "packageManager": "npm@11.19.0",
  "scripts": {
    "tokens:build": "node scripts/build-tokens.mjs",
    "prebuild": "npm run tokens:build",
    "build": "vite build && tsc -p tsconfig.build.json && sass --no-source-map --style=compressed src/styles/index.scss dist/enchanted.css",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --coverage",
    "prestorybook": "npm run tokens:build",
    "storybook": "storybook dev -p 6006",
    "prebuild-storybook": "npm run tokens:build",
    "build-storybook": "storybook build",
    "chromatic": "chromatic --project-token=$CHROMATIC_ENCHANTED_PROJECT_TOKEN",
    "figma:create": "figma connect create",
    "figma:preview": "figma connect preview",
    "figma:validate": "figma connect parse --exit-on-unreadable-files"
  },
  "peerDependencies": {
    "@base-ui/react": "^1.9.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@base-ui/react": "1.9.0",
    "@eslint/js": "10.0.1",
    "@figma/code-connect": "2.1.0",
    "@hcl-software/enchanted-icons-react": "2.1.0",
    "@storybook/addon-a11y": "10.6.3",
    "@storybook/addon-docs": "10.6.3",
    "@storybook/addon-mcp": "10.6.3",
    "@storybook/react-vite": "10.6.3",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitest/coverage-v8": "5.0.5",
    "chromatic": "18.14.4",
    "eslint": "10.15.0",
    "jsdom": "30.1.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sass": "1.108.2",
    "storybook": "10.6.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2",
    "vite": "8.3.8",
    "vitest": "5.0.5",
    "vitest-axe": "0.1.0"
  }
}
